# Upload limits are configured here and mirrored by the API and Docker setup.
VITE_BRAND_NAME=Formatku
VITE_MAX_FILE_MB=1024
VITE_MAX_BATCH_MB=1024
VITE_MAX_SERVER_FILE_MB=1024
VITE_MAX_FILES=50

# Optional executable paths when these tools are not on PATH
LIBREOFFICE_BIN=
GHOSTSCRIPT_BIN=
# Directory containing pdfinfo/pdftoppm (or their .exe files on Windows)
POPPLER_BIN=
MAX_FILE_MB=1024
PORT=3001
